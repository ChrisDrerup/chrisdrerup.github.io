---
const {
  number,
  year,
  journal,
  volume,
  pages,
  doi,
  url,
  image,
  note,
} = Astro.props;

const imageSrc = image
  ? `${import.meta.env.BASE_URL}${image.replace(/^\/+/, "")}`
  : null;
---

<a
  href={url}
  target="_blank"
  rel="noopener noreferrer"
  class="group block rounded-lg border border-base-300 bg-[#dce9dc] p-4 shadow-sm transition-all duration-200 hover:-translate-y-0.5 hover:shadow-md hover:border-primary/40"
>
  <div class="flex min-h-[180px] flex-col gap-5 sm:flex-row">

    {imageSrc && (
      <div class="w-[140px] flex-shrink-0 self-center">
        <img
          src={imageSrc}
          alt={`Image associated with publication ${number}`}
          class="aspect-[210/297] w-full rounded-md bg-white object-contain"
        />
      </div>
    )}

    <div class="min-w-0 flex flex-1 flex-col justify-center text-[15px] leading-relaxed">

        <!-- Authors -->
    <div>
      <strong>{number})</strong>
      <span class="font-normal">
        <slot name="authors" />
      </span>
      <span class="font-normal"> ({year})</span>
    </div>

    <!-- Title -->
    <div class="mt-1 group-hover:text-primary">
      <slot name="title" />
    </div>

    <!-- Journal -->
    <div class="mt-1">
      <strong>{journal}</strong>{volume && ` ${volume}`}{pages && `, ${pages}`}.
    </div>

    <!-- DOI -->
    {doi && (
      <div class="mt-1">
        DOI: {doi}
      </div>
    )}

    <!-- Optional note -->
    {note && (
      <div class="mt-2 italic">
        {note}
      </div>
    )}

  </div>
  </div>
</a>