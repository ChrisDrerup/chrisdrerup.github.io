---

<div class="w-full space-y-12">

  <!-- Legend -->
  <div class="flex flex-wrap justify-center gap-6 text-sm mb-4">
    <div class="flex items-center gap-2">
        <span class="w-3 h-3 rounded-full bg-[#D6AD4B]"></span>
        <span>Academic positions & education</span>
    </div>

    <div class="flex items-center gap-2">
        <span class="w-3 h-3 rounded-full bg-[#5FA777]"></span>
        <span>Lab-/ Fieldwork</span>
    </div>

    <div class="flex items-center gap-2">
        <span class="w-3 h-3 rounded-full bg-[#7E57C2]"></span>
        <span>Internships</span>
    </div>

    <div class="flex items-center gap-2">
        <span class="w-3 h-3 rounded-full bg-[#E76F51]"></span>
        <span>Major conferences</span>
    </div>
  </div>


  <!-- WORLD MAP -->
  <div>

    <div class="relative">
      <svg
        id="world-map"
        viewBox="0 0 1200 650"
        class="w-full h-auto"
        aria-label="World map showing universities, institutions and fieldwork locations"
      ></svg>

      <div
        id="world-popup"
        class="absolute hidden z-10 rounded-lg bg-[#1C4242] px-5 py-4 text-white shadow-lg max-w-[320px]"
      >
        <div
          id="world-popup-institution"
          class="font-bold text-lg"
        ></div>

        <div
          id="world-popup-position"
          class="mt-2 text-sm"
        ></div>

        <div
          id="world-popup-dates"
          class="mt-2 text-sm opacity-75"
        ></div>
      </div>
    </div>
  </div>


  <!-- EUROPE MAP -->
  <div>
    <h2 class="text-2xl font-bold mb-4 text-center">
      European close-up
    </h2>

    <div class="relative">
      <svg
        id="europe-map"
        viewBox="0 0 1200 700"
        class="w-full h-auto"
        aria-label="Map of Europe showing universities, institutions and fieldwork locations"
      ></svg>

      <div
        id="europe-popup"
        class="absolute hidden z-10 rounded-lg bg-[#1C4242] px-5 py-4 text-white shadow-lg max-w-[320px]"
      >
        <div
          id="europe-popup-institution"
          class="font-bold text-lg"
        ></div>

        <div
          id="europe-popup-position"
          class="mt-2 text-sm"
        ></div>

        <div
          id="europe-popup-dates"
          class="mt-2 text-sm opacity-75"
        ></div>
      </div>
    </div>
  </div>

</div>


<script>
  import * as d3 from "d3";
  import { feature } from "topojson-client";
  import world from "../data/countries-50m.json";


  /*
   * ==========================================================
   * LOCATIONS
   * ==========================================================
   *
   * Add every university, institution and fieldwork location here.
   *
   * lat/lon are used only to position the dot on the map.
   * They are never displayed.
   *
   * category:
   *   "academic"  = gold
   *   "fieldwork" = green
   */

  const locations = [

    {
