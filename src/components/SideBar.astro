---
import SideBarFooter from "./SideBarFooter.astro";
import { Image } from "astro:assets";
import SideBarMenu from "./SideBarMenu.astro";
const { sideBarActiveItemID } = Astro.props;
---

<div class="drawer-side z-40">
  <label for="my-drawer" class="drawer-overlay"></label>
  <aside class="px-2 pt-2 h-auto min-h-full w-[19rem] bg-base-200 text-base-content flex flex-col">
    <div class="w-full mt-5 mb-6 text-center">
      <a href="/">
        <div class="avatar transition ease-in-out hover:scale-[102%] block m-auto">
          <div class="w-[8.5rem] mx-auto">
            <Image class="mask mask-circle" format="webp" width={300} height={300} src="/profile_img.jpg" alt="Profile image" />
          </div>
        </div>
      </a>
      <div class="mt-4">
      <div class="text-xl font-bold">
        Christian Drerup
      </div>

      <div class="text-sm mt-1">
        Behavioural & Visual Ecologist
      </div>
      <div class="text-sm mt-1">
        University of Oxford, UK
      </div>
      
      </div>
    </div>

    <div class="social-icons px-4 pb-5 pt-1 flex self-center justify-center sticky bottom-0 bg-base-200">
      <a
          href="https://scholar.google.com/citations?user=I110UGoAAAAJ&hl=en"
          target="_blank"
          class="mx-3"
          aria-label="Google Scholar"
          title="Google Scholar"
      >
          <img
          src="/icons/googlescholar.svg"
          alt="Google Scholar"
          class="w-6 h-6"
          />
      </a>
      <a
          href="https://orcid.org/0000-0002-6912-6379"
          target="_blank"
          class="mx-3"
          aria-label="ORCID"
          title="ORCID"
      >
          <img
          src="/icons/orcid.svg"
          alt="ORCID"
          class="w-6 h-6"
          />
      </a>
      <a
          href="https://www.linkedin.com/in/christian-drerup-8a9958161/"
          target="_blank"
          class="mx-3"
          aria-label="LinkedIN"
          title="LinkedIN"
      >
          <img
          src="/icons/LinkedIn_icon.svg"
          alt="LinkedIN"
          class="w-6 h-6"
          />
      </a>
      <a
          href="https://bsky.app/profile/christiandrerup.com"
          target="_blank"
          class="mx-3"
          aria-label="Bluesky"
          title="Bluesky"
      >
          <img
          src="/icons/bluesky.svg"
          alt="Bluesky"
          class="w-6 h-6"
          />
      </a>
      <a
          href="https://www.instagram.com/christian.drerup.photography/"
          target="_blank"
          class="mx-3"
          aria-label="Instagram"
          title="Instagram"
      >
          <img
          src="/icons/Instagram_logo_2016.svg"
          alt="Instagram"
          class="w-6 h-6"
          />
      </a>
      
    </div>

    <SideBarMenu sideBarActiveItemID={sideBarActiveItemID} />

    <div class="flex items-center justify-center gap-6 px-4 pt-3 pb-7 bg-base-200">

      <!-- University of Oxford -->
      <a
        href="YOUR_OXFORD_PROFILE_URL"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="University of Oxford"
        title="University of Oxford"
        class="transition-transform duration-200 hover:scale-105"
      >
        <img
          src="/icons/biology_keyline.svg"
          alt="University of Oxford"
          class="h-20 w-auto object-contain"
        />
      </a>

    </div>

  </aside>
</div>
