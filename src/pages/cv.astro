---
import BaseLayout from "../layouts/BaseLayout.astro";
import TimeLineElement from "../components/cv/TimeLine.astro";
---

<BaseLayout title="Resume" sideBarActiveItemID="cv">
  <div class="mb-5">
    <div class="text-7xl w-full font-bold">Curriculum vitae</div>
  </div>
  <br>
  <div class="mb-5">
    <div class="text-3xl w-full font-bold">Education</div>
  </div>

  <div class="time-line-container grid gap-4 mb-10">
    <TimeLineElement
  title="PhD Zoology | University of Cambridge, Cambridge, UK"
  subtitle="Thesis:"
  subtitleItalic="Dynamic lighting and its impact on the behaviour of marine invertebrates"
  date="10/2020 – 06/2024"
  >
  </TimeLineElement>
    <TimeLineElement
  title="M.Sc. Marine Biology | University of Algarve, Faro, Portugal"
  subtitle="Thesis:"
  subtitleItalic="Habitat preference and behavioural ecology of bobtail squids (Sepiolidae)"
  date="09/2017 – 12/2019"
  >
  </TimeLineElement>
    <TimeLineElement
  title="B.Sc. Biology | Kiel University, Kiel, Germany"
  subtitle="Thesis:"
  subtitleItalic="The influence of terminal end structures on settlement behaviour and attachment strength in the barnacle Balanus improvisus"
  date="10/2013 – 07/2017"
  >
  </TimeLineElement>
  </div>

  <div class="mb-5">
    <div class="text-3xl w-full font-bold">Professional positions</div>
  </div>

  <div class="time-line-container grid gap-4 mb-10">
    <TimeLineElement
  title="Fellow by Examination | Magdalen College, UK"
  title2="Senior Research Fellow | University of Oxford, UK"
  subtitle="Topic:"
  subtitleItalic="Specular colouration and mirror-like camouflage in fish"
  date="04/2026 – NOW"
  >
  </TimeLineElement>
  <TimeLineElement
  title="Postdoctoral Research Associate | Durham University, UK"
  subtitle="Topic:"
  subtitleItalic="Behavioural adaptations to avoid desiccation in mosquito pupae"
  date="02/2025 – 03/2026"
  >
  </TimeLineElement>
  <TimeLineElement
  title="Postdoctoral Research Assistant | University of Cambridge, UK"
  subtitle="Topic:"
  subtitleItalic="Schooling behaviour of the Caribbean reef squid Sepioteuthis sepioidea"
  date="06/2024 – 02/2025"
  >
  </TimeLineElement>
  <TimeLineElement
  title="Research Assistant | University of Würzburg, Germany"
  subtitle="Topic:"
  subtitleItalic="Visual flower inspection and proboscis guidance behaviour in hawkmoths"
  date="04/2026 – NOW"
  >
  </TimeLineElement>
  </div>

  <div class="mb-5">
    <div class="text-3xl w-full font-bold">Certifications</div>
  </div>

  <ul class="list-disc mx-6 mb-10 grid gap-2">
    <li>
      <a href="#" target="_blank"> Certification Name (with link)</a>
    </li>
    <li>
      <a href="#" target="_blank"> Certification Name (with link)</a>
    </li>
  </ul>

  <div class="mb-5">
    <div class="text-3xl w-full font-bold">Skills</div>
  </div>

  <ul class="list-disc md:columns-5 columns-2 mx-6">
    <li>Skill Name</li>
    <li>Skill Name</li>
    <li>Skill Name</li>
    <li>Skill Name</li>
    <li>Skill Name</li>
    <li>Skill Name</li>
    <li>Skill Name</li>
    <li>Skill Name</li>
    <li>Skill Name</li>
    <li>Skill Name</li>
    <li>Skill Name</li>
    <li>Skill Name</li>
    <li>Skill Name</li>
    <li>Skill Name</li>
    <li>Skill Name</li>
  </ul>
</BaseLayout>
